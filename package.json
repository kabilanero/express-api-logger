{
  "name": "express-dev-logger",
  "version": "1.0.4",
  "description": "Lightweight and fast Express middleware for logging HTTP requests with colored output",
  "keywords": [
    "express-devlogger",
    "devlogger",
    "expresslogger",
    "expressdevlogger",
    "http-logger"
  ],
  "homepage": "https://github.com/kabilanero/express-api-logger#readme",
  "bugs": {
    "url": "https://github.com/kabilanero/express-api-logger/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kabilanero/express-api-logger.git"
  },
  "license": "ISC",
  "author": "KABILAN J",
  "type": "module",
  "main": "./dist/index.cjs",
  "scripts": {
    "build": "tsup src/index.js --format cjs,esm --clean && node scripts/fix-cjs-exports.js",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
